
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/dispatch.php?file=index.php"
    },
    {
      "src": "^/(?!api/)(.*\\.php)$",
      "dest": "/api/dispatch.php?file=$1"
    }
  ]
}
